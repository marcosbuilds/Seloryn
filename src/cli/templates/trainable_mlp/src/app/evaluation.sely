module app.evaluation

from app.checkpoint import restore
from app.contracts import Contract, load_contract
from app.data import Dataset, load_dataset
from app.model import Model
from app.training import accuracy, loss
from audit import emit
from data import to_f64
from json import from_f64, from_text, object, read_file, sha256

pub record EvaluationReport:
    schema: Text
    model_id: Text
    test_loss: F32
    test_accuracy: F64
    checkpoint_sha256: Text
    dataset_spec_sha256: Text
    model_spec_sha256: Text

pub fn run_eval() -> Result[EvaluationReport, JsonIoError]:
    let contract: Contract = load_contract()?
    let train_data: Dataset = load_dataset("data/train.json", contract.train_rows, contract)?
    let test_data: Dataset = load_dataset("data/test.json", contract.test_rows, contract)?
    let model: Model = restore("checkpoints/model.json", contract, train_data, test_data)?
    let checkpoint: Json = read_file("checkpoints/model.json")?
    let checkpoint_sha256: Text = sha256(checkpoint)
    let report: Json = object(["operation", "model_id", "test_loss", "test_accuracy", "checkpoint_sha256"], [from_text("eval"), from_text(contract.model_id), from_f64(to_f64(loss(test_data, model))), from_f64(accuracy(test_data, model)), from_text(checkpoint_sha256)])?
    emit("evaluation.complete", report)
    return Ok(EvaluationReport("seloryn.evaluation.v1", contract.model_id, loss(test_data, model), accuracy(test_data, model), checkpoint_sha256, contract.dataset_spec_hash, contract.model_spec_hash))
