{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seloryn.dev/schemas/agent-visible-transcript.v1.json",
  "title": "Seloryn visible agent transcript",
  "type": "object",
  "required": ["schema", "run_id", "task_id", "messages"],
  "properties": {
    "schema": {"const": "seloryn.agent-visible-transcript.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "condition": {"type": ["string", "null"]},
    "capture_scope": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": {"enum": ["system", "user", "tool", "assistant"]},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
