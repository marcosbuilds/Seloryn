{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seloryn.dev/schemas/agent-run.v1.json",
  "title": "Seloryn redacted agent evaluation run",
  "description": "Backend-neutral, privacy-bounded run and trajectory contract. Null or unknown values are not zero or success.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "case_id",
    "experiment_id",
    "condition",
    "status",
    "dataset",
    "environment",
    "trajectory",
    "metrics",
    "graders",
    "hard_invariants",
    "privacy",
    "evidence"
  ],
  "properties": {
    "schema": {"const": "seloryn.agent-run"},
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "case_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "condition": {"$ref": "#/$defs/id"},
    "status": {"enum": ["completed", "failed", "timeout", "aborted", "unknown"]},
    "parent_run_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "dataset": {"$ref": "#/$defs/dataset"},
    "agent": {"$ref": "#/$defs/agent"},
    "environment": {"$ref": "#/$defs/environment"},
    "trajectory": {"$ref": "#/$defs/trajectory"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "graders": {"type": "array", "items": {"$ref": "#/$defs/grader"}},
    "hard_invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
    "privacy": {"$ref": "#/$defs/privacy"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "decision": {"anyOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "suite_version", "manifest_sha256", "frozen"],
      "properties": {
        "suite_id": {"$ref": "#/$defs/id"},
        "suite_version": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/hash"},
        "frozen": {"const": true},
        "case_sha256": {"$ref": "#/$defs/hash"},
        "source_class": {"enum": ["synthetic", "curated", "adversarial", "regression", "production_transformed"]},
        "slice": {"$ref": "#/$defs/id"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_version": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "policy_version": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "provider": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "model": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "platform", "network", "permission_profile"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/hash"},
        "binary_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "platform": {"type": "string", "minLength": 1, "maxLength": 128},
        "tool_profile": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "network": {"enum": ["disabled", "allowlisted", "enabled", "unknown"]},
        "permission_profile": {"$ref": "#/$defs/id"}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "obligations", "stop_reason"],
      "properties": {
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
        "stop_reason": {"enum": ["completed", "failed", "timeout", "cancelled", "escalated", "aborted", "unknown"]}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "sequence", "kind", "outcome", "authority", "effect"],
      "properties": {
        "step_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["plan", "inspect", "tool", "model", "state", "handoff", "review", "stop"]},
        "outcome": {"enum": ["ok", "error", "timeout", "abstained", "unknown"]},
        "error_class": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "retry_of": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "tool_name": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "argument_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "result_digest": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "authority": {"enum": ["allowed", "denied", "not_applicable", "unknown"]},
        "effect": {"enum": ["none", "planned", "committed", "rolled_back", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "status"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["met", "missed", "abstained", "escalated", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "owner": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance", "provider", "local_reconstruction", "missingness"],
      "properties": {
        "acceptance": {"enum": ["passed", "failed", "not_run", "unknown"]},
        "provider": {"$ref": "#/$defs/provider_metrics"},
        "local_reconstruction": {"$ref": "#/$defs/local_metrics"},
        "missingness": {"type": "array", "items": {"$ref": "#/$defs/missing"}}
      }
    },
    "provider_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "total_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "calls": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "attempts": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "duration_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "cost_usd": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "success": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}
      }
    },
    "local_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_class": {"const": "visible-transcript-only"},
        "not_provider_billing": {"const": true},
        "input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "visible_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "encoding": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "status"],
      "properties": {
        "field": {"$ref": "#/$defs/id"},
        "status": {"enum": ["not_collected", "not_applicable", "redacted", "error", "unknown"]},
        "reason": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}]}
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grader_id", "version", "result", "abstained"],
      "properties": {
        "grader_id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/id"},
        "result": {"enum": ["pass", "fail", "unknown"]},
        "abstained": {"type": "boolean"},
        "score": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "result"],
      "properties": {
        "invariant_id": {"$ref": "#/$defs/id"},
        "result": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "owner": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_scope", "raw_content", "redaction_version", "retention_class"],
      "properties": {
        "capture_scope": {"enum": ["metadata_only", "approved_opt_in", "unknown"]},
        "raw_content": {"const": false},
        "redaction_version": {"$ref": "#/$defs/id"},
        "retention_class": {"$ref": "#/$defs/id"},
        "access_class": {"$ref": "#/$defs/id"},
        "deletion_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "kind": {"enum": ["source", "test", "trace", "fixture", "provider_export", "sandbox_state", "review"]},
        "sha256": {"$ref": "#/$defs/hash"},
        "owner": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "owner", "evidence_refs", "rollback_ref"],
      "properties": {
        "verdict": {"enum": ["approved", "approved_with_conditions", "hold_insufficient_evidence", "blocked"]},
        "owner": {"$ref": "#/$defs/id"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "conditions": {"type": "array", "items": {"type": "string", "maxLength": 256}},
        "rollback_ref": {"$ref": "#/$defs/ref"},
        "next_review_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    }
  }
}
