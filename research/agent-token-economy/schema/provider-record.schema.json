{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seloryn.dev/schemas/agent-token-economy-provider-record-v1.json",
  "title": "Provider-supplied agent evaluation record",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "task_id", "evidence_class", "provider", "metrics"],
  "properties": {
    "schema": {"const": "seloryn.agent-token-economy.provider-record"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[AB]-[0-9]{2}$"},
    "condition": {"type": ["string", "null"]},
    "evidence_class": {"type": "string", "enum": ["provider-export", "synthetic-replay"]},
    "provider": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "model": {}, "version": {}, "run_url": {}}, "additionalProperties": true},
    "metrics": {"$ref": "#/$defs/metrics"},
    "regressions": {"type": ["array", "null"]},
    "human_intervention": {"type": ["object", "null"]}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "integer", "null"]},
    "metrics": {
      "type": "object",
      "properties": {
        "tokens": {"type": ["object", "null"], "properties": {"input": {"type": ["integer", "null"]}, "output": {"type": ["integer", "null"]}, "total": {"type": ["integer", "null"]}}, "additionalProperties": true},
        "calls": {"type": ["integer", "null"]},
        "attempts": {"type": ["integer", "null"]},
        "duration_seconds": {"$ref": "#/$defs/nullableNumber"},
        "cost_usd": {"$ref": "#/$defs/nullableNumber"},
        "success": {"type": ["boolean", "null"]},
        "files_changed": {"type": ["integer", "null"]},
        "lines_added": {"type": ["integer", "null"]},
        "lines_deleted": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
