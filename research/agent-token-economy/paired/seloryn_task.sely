# TOKEN-PAIR-01 / Seloryn condition.
# task_id: visible-text-metrics
# prompt: Compute visible Unicode codepoint and UTF-8 byte lengths for each
# sample. Return one stable JSON result with the sample identifiers, metrics
# and totals. Do not call external services or infer provider billing.
# The Python condition uses these exact three visible input strings and ids:
# ascii, portuguese, tensor.
#
# supported_metric: unicode_codepoints
# utf8_bytes_status: unsupported
# stable_json_status: unsupported
# tokenization_status: unsupported
# openai_bpe_status: unsupported
# billing_status: not_provider_billing
#
# This source deliberately does not emulate OpenAI tokenization. The current
# Seloryn runtime exposes len(Text) as Unicode scalar count, but it has no BPE
# tokenizer and no provider billing or hidden-context telemetry API.

from data import len

fn measure(value: Text) -> I64:
    return len(value)

fn main() -> I64:
    let first: Text = "hello world"
    let second: Text = "caractere por caractere"
    let third: Text = "Tensor[F32, shape=[2, 2]]"
    return measure(first) + measure(second) + measure(third)
