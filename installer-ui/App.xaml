<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SelorynInstaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="BlackColor">#000000</Color>
            <Color x:Key="SurfaceColor">#0A1411</Color>
            <Color x:Key="RaisedColor">#11231D</Color>
            <Color x:Key="BorderColor">#214D3E</Color>
            <Color x:Key="MintColor">#2BD1A0</Color>
            <Color x:Key="MintBrightColor">#5BE7BE</Color>
            <Color x:Key="TextColor">#F5FFFA</Color>
            <Color x:Key="TextMutedColor">#A9C4B8</Color>
            <Color x:Key="DimColor">#668277</Color>
            <Color x:Key="ErrorColor">#FF687C</Color>
            <Color x:Key="AmbientLineColor">#123A30</Color>
            <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
            <SolidColorBrush x:Key="MintBrightBrush" Color="{StaticResource MintBrightColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
            <SolidColorBrush x:Key="AmbientLineBrush" Color="{StaticResource AmbientLineColor}" />
            <FontFamily x:Key="BodyFont">/SelorynInstaller/Assets/seloryn-font-light.ttf#Seloryn Font</FontFamily>
            <FontFamily x:Key="DisplayFont">/SelorynInstaller/Assets/seloryn-font-bold.ttf#Seloryn Font</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
