<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SelorynInstaller.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BlackBrush}"
    FontFamily="{StaticResource BodyFont}">

    <Grid Padding="32,18,32,24" Background="{StaticResource BlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Canvas Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.82">
            <Path x:Name="AmbientFlowTop" Data="M 0,178 C 150,80 258,286 432,186 S 716,82 920,204" Stroke="{StaticResource AmbientLineBrush}" StrokeThickness="1.25" StrokeDashArray="24,26" StrokeDashOffset="50" />
            <Path x:Name="AmbientFlowBottom" Data="M -40,500 C 140,408 260,568 438,492 S 710,392 920,520" Stroke="{StaticResource AmbientLineBrush}" StrokeThickness="1" StrokeDashArray="18,22" StrokeDashOffset="40" />
            <Path x:Name="AmbientFlowAccent" Data="M 644,30 C 718,74 700,146 770,160 S 856,186 910,142" Stroke="{StaticResource MintBrush}" StrokeThickness="1" Opacity="0.20" StrokeDashArray="12,18" StrokeDashOffset="30" />
        </Canvas>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="3">
                <Image x:Name="BrandLogo" Width="150" Height="42" HorizontalAlignment="Left" Source="Assets/seloryn-logo.svg" Stretch="Uniform" Opacity="0">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="BrandLogoTransform" TranslateX="-12" ScaleX="0.97" ScaleY="0.97" />
                    </Image.RenderTransform>
                </Image>
                <TextBlock Text="RUNTIME SETUP" FontSize="10" CharacterSpacing="160" Foreground="{StaticResource DimBrush}" Margin="2,1,0,0" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
                    <Ellipse x:Name="Step1Dot" Width="28" Height="28" Fill="{StaticResource MintBrush}"><Ellipse.Stroke><SolidColorBrush Color="#5BE7BE" /></Ellipse.Stroke></Ellipse>
                    <TextBlock x:Name="Step1Number" Text="01" FontSize="10" Foreground="{StaticResource BlackBrush}" HorizontalAlignment="Center" Margin="0,-25,0,0" />
                    <TextBlock Text="WELCOME" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource MintBrightBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <Rectangle x:Name="StepLine1" Grid.Column="1" Height="1" Fill="{StaticResource BorderBrush}" Margin="10,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                    <Ellipse x:Name="Step2Dot" Width="28" Height="28" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                    <TextBlock x:Name="Step2Number" Text="02" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-25,0,0" />
                    <TextBlock Text="LOCATION" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <Rectangle x:Name="StepLine2" Grid.Column="3" Height="1" Fill="{StaticResource BorderBrush}" Margin="10,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="4" Spacing="6" HorizontalAlignment="Center">
                    <Ellipse x:Name="Step3Dot" Width="28" Height="28" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                    <TextBlock x:Name="Step3Number" Text="03" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-25,0,0" />
                    <TextBlock Text="INSTALL" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <Rectangle x:Name="StepLine3" Grid.Column="5" Height="1" Fill="{StaticResource BorderBrush}" Margin="10,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="6" Spacing="6" HorizontalAlignment="Center">
                    <Ellipse x:Name="Step4Dot" Width="28" Height="28" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                    <TextBlock x:Name="Step4Number" Text="04" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-25,0,0" />
                    <TextBlock Text="DONE" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="WelcomePanel" Visibility="Visible">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" /><ColumnDefinition Width="0.82*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="12" Padding="2,0,36,0">
                    <TextBlock Text="A clean runtime.&#x0a;Kept local." FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Install the verified Seloryn runtime for your user account. No admin prompt. No clutter." FontSize="14" LineHeight="24" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="410" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6"><TextBlock Text="PER-USER" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource MintBrightBrush}" /></Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6"><TextBlock Text="VERIFIED" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource TextMutedBrush}" /></Border>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><Ellipse Width="6" Height="6" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" /><TextBlock Text="READY TO INSTALL" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource MintBrightBrush}" /></StackPanel>
                        <Image Grid.Row="1" Source="Assets/seloryn-logo.svg" Width="196" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                        <StackPanel Grid.Row="2" Spacing="3"><TextBlock Text="EXPERIMENTAL BETA" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="{StaticResource TextBrush}" /><TextBlock Text="Windows x64  ·  private preview" FontSize="11" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="LocationPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="6"><TextBlock Text="Choose where Seloryn lives" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="The installer keeps everything in one user-owned folder so it is easy to remove or move later." FontSize="13" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                <Grid Grid.Row="1" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.24*" /><ColumnDefinition Width="0.76*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,16,0">
                        <StackPanel Spacing="14">
                            <TextBlock Text="INSTALL ROOT" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource MintBrightBrush}" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="PathTextBox" Grid.Column="0" Text="" PlaceholderText="C:\Users\you\AppData\Local\Seloryn" FontSize="13" Padding="12,10" Background="{StaticResource BlackBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" /><Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Click="BrowseButton_Click" Margin="10,0,0,0" Padding="16,8" Background="{StaticResource RaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" /></Grid>
                            <TextBlock Text="A per-user install does not require administrator permission." FontSize="11" Foreground="{StaticResource DimBrush}" />
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,3,0,0" />
                            <CheckBox x:Name="AddPathCheckBox" IsChecked="True" Content="Add Seloryn to my user PATH" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                            <CheckBox x:Name="MakeDefaultCheckBox" IsChecked="True" Content="Make this the default runtime" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                            <CheckBox x:Name="CleanPreviousCheckBox" Content="Remove previous Seloryn installations" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="20" VerticalAlignment="Top"><StackPanel Spacing="10"><Image Source="Assets/seloryn-folder.svg" Width="42" Height="42" HorizontalAlignment="Left" /><TextBlock Text="One focused install" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="The runtime, launcher and version state stay together. Your projects remain untouched." FontSize="12" LineHeight="20" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                </Grid>
            </Grid>

            <Grid x:Name="InstallPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="6"><TextBlock Text="Installing Seloryn" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock x:Name="InstallStatus" Text="Preparing the installation…" FontSize="13" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,22,0,18" Padding="16"><ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" LineHeight="19" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" /></ScrollViewer></Border>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ProgressBar x:Name="InstallProgress" Grid.Column="0" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource MintBrush}" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center" /><TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MintBrightBrush}" Margin="14,0,0,0" /></Grid>
            </Grid>

            <Grid x:Name="DonePanel" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Spacing="13"><Border Width="62" Height="62" CornerRadius="31" Background="{StaticResource MintBrush}" HorizontalAlignment="Center"><TextBlock Text="✓" FontSize="32" Foreground="{StaticResource BlackBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Seloryn is ready" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" /><TextBlock Text="The runtime was installed for this user. Open a fresh terminal to use it." FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" /><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,4"><StackPanel Spacing="5"><TextBlock Text="INSTALL ROOT" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource MintBrightBrush}" /><TextBlock x:Name="DonePathText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" /></StackPanel></Border></StackPanel></Grid>
        </Grid>

        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready to begin." FontSize="12" Foreground="{StaticResource DimBrush}" /></StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelButton_Click" Margin="0,0,10,0" Padding="18,10" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" />
            <Button x:Name="BackButton" Grid.Column="2" Content="Back" Visibility="Collapsed" Click="BackButton_Click" Margin="0,0,10,0" Padding="18,10" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" />
            <Button x:Name="PrimaryButton" Grid.Column="3" Content="Continue  ›" Click="PrimaryButton_Click" Padding="22,10" Background="{StaticResource MintBrush}" Foreground="{StaticResource BlackBrush}" BorderBrush="{StaticResource MintBrush}" BorderThickness="1" CornerRadius="5" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Page>
