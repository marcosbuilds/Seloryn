module app.optim

from app.parameters import Parameter, replace

pub record Sgd:
    learning_rate: Tensor[F32]

pub fn sgd(learning_rate: Tensor[F32]) -> Sgd:
    return Sgd(learning_rate)

pub fn step(optimizer: Sgd, parameter: Parameter, gradient: Tensor[F32]) -> Parameter:
    return replace(parameter, parameter.value - optimizer.learning_rate * gradient)
