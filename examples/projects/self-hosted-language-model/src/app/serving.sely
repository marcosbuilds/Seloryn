module app.serving

from app.checkpoint import restore_checkpoint, restore_embedding_checkpoint, EmbeddingCheckpoint
from app.data import window_as_ids, window_as_one_hot
from app.model import EmbeddingModel, LanguageModel, embedding_probabilities, probabilities
from app.tokenizer import Vocabulary, load_vocabulary, token_id, token_text, tokenize, tokenize_text
from data import len, range, to_f64
from json import as_i64, as_text, as_text_list, get, read_file, sha256

pub record InferenceReport:
    mode: Text
    prompt_tokens: I64
    context_size: I64
    generation_steps: I64
    generated: Text
    first_token_probability: F32
    checkpoint_sha256: Text
    status: Text

fn argmax(probabilities: Tensor[F32], row: I64, vocabulary_size: I64) -> I64:
    var best: I64 = 0
    let first: F32 = tensor_get_f32(probabilities, [row, 0])
    var best_value: F32 = first
    for token in range(vocabulary_size):
        let candidate: F32 = tensor_get_f32(probabilities, [row, token])
        if candidate > best_value:
            best = token
            best_value = candidate
    return best

pub fn accuracy(inputs: Tensor[F32], targets: Tensor[F32], model: LanguageModel, rows: I64, vocabulary_size: I64) -> F64:
    let predictions: Tensor[F32] = probabilities(inputs, model)
    var correct: F64 = 0.0
    for row in range(rows):
        let predicted: I64 = argmax(predictions, row, vocabulary_size)
        let expected: I64 = argmax(targets, row, vocabulary_size)
        if predicted == expected:
            correct = correct + 1.0
    return correct / to_f64(rows)

pub fn generate(model: LanguageModel, vocabulary: Vocabulary, eos: I64, start: I64, steps: I64) -> Text:
    var prompt: List[I64] = []
    for _index in range(model.context_size):
        prompt = prompt + [start]
    return generate_from(model, vocabulary, eos, prompt, steps)

pub fn generate_from(model: LanguageModel, vocabulary: Vocabulary, eos: I64, prompt: List[I64], steps: I64) -> Text:
    var window: List[I64] = prompt
    var output: Text = ""
    var finished: Bool = false
    for _step in range(steps):
        if not finished:
            let window_start: I64 = len(window) - model.context_size
            let features: List[F64] = window_as_one_hot(window, window_start, model.context_size, vocabulary.size)
            let input: Tensor[F32] = tensor_f32(features, [1, model.context_size * vocabulary.size])
            let next: I64 = argmax(probabilities(input, model), 0, vocabulary.size)
            if output == "":
                output = token_text(vocabulary, next)
            else:
                output = output + " " + token_text(vocabulary, next)
            window = window + [next]
            if next == eos:
                finished = true
    return output

fn infer_request(request: Json, text_prompt: Bool) -> Result[InferenceReport, JsonIoError]:
    let generation_steps: I64 = as_i64(get(request, ["generation_steps"])?)?
    require generation_steps > 0 else JsonIoError("inference generation_steps must be positive")
    let vocabulary: Vocabulary = load_vocabulary("data/vocab.json")?
    var encoded: List[I64] = []
    if text_prompt:
        let text: Text = as_text(get(request, ["text"])?)?
        encoded = tokenize_text(vocabulary, text)?
    else:
        let prompt: List[Text] = as_text_list(get(request, ["tokens"])?)?
        let prompt_count: I64 = as_i64(get(request, ["prompt_count"])?)?
        require prompt_count > 0 else JsonIoError("inference prompt_count must be positive")
        let tokenized: List[I64] = tokenize(vocabulary, prompt)?
        let supplied_count: I64 = len(tokenized)
        require supplied_count == prompt_count else JsonIoError("prompt_count must match tokens")
        encoded = tokenized
    let actual_count: I64 = len(encoded)
    let eos: I64 = token_id(vocabulary, "<eos>")?
    let model: LanguageModel = restore_checkpoint("checkpoints/language-model.json", vocabulary)?
    require actual_count >= model.context_size else JsonIoError("prompt must contain at least context_size tokens")
    let checkpoint: Json = read_file("checkpoints/language-model.json")?
    let window_start: I64 = actual_count - model.context_size
    let features: List[F64] = window_as_one_hot(encoded, window_start, model.context_size, vocabulary.size)
    let input: Tensor[F32] = tensor_f32(features, [1, model.context_size * vocabulary.size])
    let prediction: Tensor[F32] = probabilities(input, model)
    let first_token: I64 = argmax(prediction, 0, vocabulary.size)
    let first_probability: F32 = tensor_get_f32(prediction, [0, first_token])
    let generated: Text = generate_from(model, vocabulary, eos, encoded, generation_steps)
    var mode: Text = "infer"
    if text_prompt:
        mode = "infer_text"
    return Ok(InferenceReport(mode, actual_count, model.context_size, generation_steps, generated, first_probability, sha256(checkpoint), "ok"))

pub fn infer(request: Json) -> Result[InferenceReport, JsonIoError]:
    return infer_request(request, false)

pub fn infer_text(request: Json) -> Result[InferenceReport, JsonIoError]:
    return infer_request(request, true)

pub fn embedding_accuracy(inputs: Tensor[I64], targets: Tensor[I64], model: EmbeddingModel, rows: I64, vocabulary_size: I64) -> F64:
    let predictions: Tensor[F32] = embedding_probabilities(inputs, model)
    var correct: F64 = 0.0
    for row in range(rows):
        let predicted: I64 = argmax(predictions, row, vocabulary_size)
        let expected: I64 = tensor_get_i64(targets, [row])
        if predicted == expected:
            correct = correct + 1.0
    return correct / to_f64(rows)

pub fn generate_embedding(model: EmbeddingModel, vocabulary: Vocabulary, eos: I64, start: I64, steps: I64) -> Text:
    var prompt: List[I64] = []
    for _index in range(model.context_size):
        prompt = prompt + [start]
    return generate_embedding_from(model, vocabulary, eos, prompt, steps)

pub fn generate_embedding_from(model: EmbeddingModel, vocabulary: Vocabulary, eos: I64, prompt: List[I64], steps: I64) -> Text:
    var window: List[I64] = prompt
    var output: Text = ""
    var finished: Bool = false
    for _step in range(steps):
        if not finished:
            let window_start: I64 = len(window) - model.context_size
            let ids: List[I64] = window_as_ids(window, window_start, model.context_size)
            let input: Tensor[I64] = tensor_i64(ids, [1, model.context_size])
            let next: I64 = argmax(embedding_probabilities(input, model), 0, vocabulary.size)
            if output == "":
                output = token_text(vocabulary, next)
            else:
                output = output + " " + token_text(vocabulary, next)
            window = window + [next]
            if next == eos:
                finished = true
    return output

fn infer_embedding_request(request: Json, text_prompt: Bool) -> Result[InferenceReport, JsonIoError]:
    let generation_steps: I64 = as_i64(get(request, ["generation_steps"])?)?
    require generation_steps > 0 else JsonIoError("embedding inference generation_steps must be positive")
    let vocabulary: Vocabulary = load_vocabulary("data/vocab.json")?
    var encoded: List[I64] = []
    if text_prompt:
        let text: Text = as_text(get(request, ["text"])?)?
        encoded = tokenize_text(vocabulary, text)?
    else:
        let prompt: List[Text] = as_text_list(get(request, ["tokens"])?)?
        let prompt_count: I64 = as_i64(get(request, ["prompt_count"])?)?
        require prompt_count > 0 else JsonIoError("embedding prompt_count must be positive")
        let tokenized: List[I64] = tokenize(vocabulary, prompt)?
        require len(tokenized) == prompt_count else JsonIoError("prompt_count must match tokens")
        encoded = tokenized
    let actual_count: I64 = len(encoded)
    let eos: I64 = token_id(vocabulary, "<eos>")?
    let restored: EmbeddingCheckpoint = restore_embedding_checkpoint("checkpoints/language-model-embedding.json", vocabulary)?
    let model: EmbeddingModel = restored.model
    require actual_count >= model.context_size else JsonIoError("embedding prompt must contain at least context_size tokens")
    let checkpoint: Json = read_file("checkpoints/language-model-embedding.json")?
    let window_start: I64 = actual_count - model.context_size
    let ids: List[I64] = window_as_ids(encoded, window_start, model.context_size)
    let input: Tensor[I64] = tensor_i64(ids, [1, model.context_size])
    let prediction: Tensor[F32] = embedding_probabilities(input, model)
    let first_token: I64 = argmax(prediction, 0, vocabulary.size)
    let first_probability: F32 = tensor_get_f32(prediction, [0, first_token])
    let generated: Text = generate_embedding_from(model, vocabulary, eos, encoded, generation_steps)
    var mode: Text = "infer_embedding"
    if text_prompt:
        mode = "infer_embedding_text"
    return Ok(InferenceReport(mode, actual_count, model.context_size, generation_steps, generated, first_probability, sha256(checkpoint), "ok"))

pub fn infer_embedding(request: Json) -> Result[InferenceReport, JsonIoError]:
    return infer_embedding_request(request, false)

pub fn infer_embedding_text(request: Json) -> Result[InferenceReport, JsonIoError]:
    return infer_embedding_request(request, true)
