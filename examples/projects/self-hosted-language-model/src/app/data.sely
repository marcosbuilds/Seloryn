module app.data

from app.tokenizer import Vocabulary, tokenize
from data import len, range
from json import as_text_list, get, read_file, sha256

pub record Dataset:
    inputs: Tensor[F32]
    targets: Tensor[F32]
    rows: I64
    source_hash: Text

fn indicator(token: I64, expected: I64) -> F64:
    if token == expected:
        return 1.0
    return 0.0

pub fn one_hot(token: I64, vocabulary_size: I64) -> List[F64]:
    var encoded: List[F64] = []
    for expected in range(vocabulary_size):
        encoded = encoded + [indicator(token, expected)]
    return encoded

fn rows_as_one_hot(tokens: List[I64], rows: I64, vocabulary_size: I64, offset: I64) -> List[F64]:
    var encoded: List[F64] = []
    for row in range(rows):
        encoded = encoded + one_hot(tokens[row + offset], vocabulary_size)
    return encoded

pub fn load_dataset(path: Text, vocabulary: Vocabulary) -> Result[Dataset, JsonIoError]:
    let document: Json = read_file(path)?
    let raw_tokens: List[Text] = as_text_list(get(document, ["tokens"])?)?
    let token_count: I64 = len(raw_tokens)
    require token_count > 1 else JsonIoError("dataset must contain at least two tokens")
    let rows: I64 = token_count - 1
    let tokens: List[I64] = tokenize(vocabulary, raw_tokens)?
    let input_values: List[F64] = rows_as_one_hot(tokens, rows, vocabulary.size, 0)
    let target_values: List[F64] = rows_as_one_hot(tokens, rows, vocabulary.size, 1)
    return Ok(Dataset(tensor_f32(input_values, [rows, vocabulary.size]), tensor_f32(target_values, [rows, vocabulary.size]), rows, sha256(document)))
