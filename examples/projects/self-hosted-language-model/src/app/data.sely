module app.data

from app.tokenizer import Vocabulary, tokenize
from data import len, range
from json import as_text_list, get, read_file, sha256

pub record Dataset:
    inputs: Tensor[F32]
    targets: Tensor[F32]
    rows: I64
    source_hash: Text

pub record IndexedDataset:
    inputs: Tensor[I64]
    targets: Tensor[I64]
    rows: I64
    source_hash: Text

fn indicator(token: I64, expected: I64) -> F64:
    if token == expected:
        return 1.0
    return 0.0

pub fn one_hot(token: I64, vocabulary_size: I64) -> List[F64]:
    var encoded: List[F64] = []
    for expected in range(vocabulary_size):
        encoded = encoded + [indicator(token, expected)]
    return encoded

fn rows_as_one_hot(tokens: List[I64], rows: I64, vocabulary_size: I64, context_size: I64, offset: I64) -> List[F64]:
    var encoded: List[F64] = []
    for row in range(rows):
        for position in range(context_size):
            encoded = encoded + one_hot(tokens[row + position + offset], vocabulary_size)
    return encoded

fn rows_as_ids(tokens: List[I64], rows: I64, context_size: I64) -> List[I64]:
    var encoded: List[I64] = []
    for row in range(rows):
        for position in range(context_size):
            encoded = encoded + [tokens[row + position]]
    return encoded

fn target_rows_as_ids(tokens: List[I64], rows: I64, context_size: I64) -> List[I64]:
    var encoded: List[I64] = []
    for row in range(rows):
        encoded = encoded + [tokens[row + context_size]]
    return encoded

pub fn target_rows_as_one_hot(tokens: List[I64], rows: I64, vocabulary_size: I64, context_size: I64) -> List[F64]:
    var encoded: List[F64] = []
    for row in range(rows):
        encoded = encoded + one_hot(tokens[row + context_size], vocabulary_size)
    return encoded

pub fn window_as_one_hot(tokens: List[I64], start: I64, context_size: I64, vocabulary_size: I64) -> List[F64]:
    var encoded: List[F64] = []
    for position in range(context_size):
        encoded = encoded + one_hot(tokens[start + position], vocabulary_size)
    return encoded

pub fn window_as_ids(tokens: List[I64], start: I64, context_size: I64) -> List[I64]:
    var encoded: List[I64] = []
    for position in range(context_size):
        encoded = encoded + [tokens[start + position]]
    return encoded

pub fn load_dataset(path: Text, vocabulary: Vocabulary, context_size: I64) -> Result[Dataset, JsonIoError]:
    let document: Json = read_file(path)?
    let raw_tokens: List[Text] = as_text_list(get(document, ["tokens"])?)?
    let token_count: I64 = len(raw_tokens)
    require context_size > 0 else JsonIoError("context_size must be positive")
    require token_count > context_size else JsonIoError("dataset must contain more tokens than context_size")
    let rows: I64 = token_count - context_size
    let tokens: List[I64] = tokenize(vocabulary, raw_tokens)?
    let input_values: List[F64] = rows_as_one_hot(tokens, rows, vocabulary.size, context_size, 0)
    let target_values: List[F64] = target_rows_as_one_hot(tokens, rows, vocabulary.size, context_size)
    let input_width: I64 = context_size * vocabulary.size
    return Ok(Dataset(tensor_f32(input_values, [rows, input_width]), tensor_f32(target_values, [rows, vocabulary.size]), rows, sha256(document)))

pub fn load_indexed_dataset(path: Text, vocabulary: Vocabulary, context_size: I64) -> Result[IndexedDataset, JsonIoError]:
    let document: Json = read_file(path)?
    let raw_tokens: List[Text] = as_text_list(get(document, ["tokens"])?)?
    let token_count: I64 = len(raw_tokens)
    require context_size > 0 else JsonIoError("context_size must be positive")
    require token_count > context_size else JsonIoError("dataset must contain more tokens than context_size")
    let rows: I64 = token_count - context_size
    let tokens: List[I64] = tokenize(vocabulary, raw_tokens)?
    let input_values: List[I64] = rows_as_ids(tokens, rows, context_size)
    let target_values: List[I64] = target_rows_as_ids(tokens, rows, context_size)
    return Ok(IndexedDataset(tensor_i64(input_values, [rows, context_size]), tensor_i64(target_values, [rows]), rows, sha256(document)))
