module app.production

from app.contracts import Contract, load_contract
from app.serving import InferenceReport, infer
from app.training import TrainingReport, run
from json import as_text, get, read_stdin

pub enum Response:
    Training(TrainingReport)
    Inference(InferenceReport)

pub fn request() -> Result[Response, JsonIoError]:
    let document: Json = read_stdin()?
    let mode: Text = as_text(get(document, ["mode"])?)?
    if mode == "train":
        let report: TrainingReport = run()?
        return Ok(Training(report))
    if mode == "infer":
        let contract: Contract = load_contract()?
        let report: InferenceReport = infer(document, contract)?
        return Ok(Inference(report))
    return Err(JsonIoError("mode must be train or infer"))
