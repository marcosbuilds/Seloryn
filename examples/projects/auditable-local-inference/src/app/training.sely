module app.training

from app.checkpoint import restore, save
from app.contracts import Contract, load_contract
from app.data import Dataset, load_dataset
from app.model import Model, initial, objective, forward
from app.optim import Parameter, Sgd, parameter, sgd, step
from autograd import gradients
from data import range, to_f64
from training import progress

pub record TrainingReport:
    schema: Text
    model_id: Text
    steps: I64
    initial_loss: F32
    final_loss: F32
    test_loss: F32
    reloaded_loss: F32
    test_accuracy: F64
    checkpoint_sha256: Text
    dataset_spec_sha256: Text
    model_spec_sha256: Text

fn evaluate(dataset: Dataset, model: Model) -> F32:
    return tensor_item_f32(objective(dataset.inputs, model.first, model.first_bias, model.second, model.second_bias, dataset.targets))

fn accuracy(dataset: Dataset, model: Model) -> F64:
    let predictions: Tensor[F32] = forward(dataset.inputs, model)
    var correct: I64 = 0
    for index in range(dataset.rows):
        let prediction: F32 = tensor_get_f32(predictions, [index, 0])
        let expected: F32 = tensor_get_f32(dataset.targets, [index, 0])
        if (prediction >= 0.5 and expected >= 0.5) or (prediction < 0.5 and expected < 0.5):
            correct = correct + 1
    return to_f64(correct) / to_f64(dataset.rows)

pub fn run() -> Result[TrainingReport, JsonIoError]:
    let contract: Contract = load_contract()?
    let train_data: Dataset = load_dataset("data/train.json", contract.train_rows, contract)?
    let test_data: Dataset = load_dataset("data/test.json", contract.test_rows, contract)?
    let optimizer: Sgd = sgd(contract.learning_rate)
    let seed_model: Model = initial()
    var first: Parameter = parameter("first", seed_model.first)
    var first_bias: Parameter = parameter("first_bias", seed_model.first_bias)
    var second: Parameter = parameter("second", seed_model.second)
    var second_bias: Parameter = parameter("second_bias", seed_model.second_bias)
    let initial_model: Model = Model(first.value, first_bias.value, second.value, second_bias.value)
    let initial_loss: F32 = evaluate(train_data, initial_model)
    for step_index in range(contract.steps):
        let derivatives: List[Tensor[F32]] = gradients(objective, train_data.inputs, first.value, first_bias.value, second.value, second_bias.value, train_data.targets)
        first = step(optimizer, first, derivatives[1])
        first_bias = step(optimizer, first_bias, derivatives[2])
        second = step(optimizer, second, derivatives[3])
        second_bias = step(optimizer, second_bias, derivatives[4])
        let current_step: I64 = step_index + 1
        if current_step == 1 or current_step % 16 == 0 or current_step == contract.steps:
            let live_model: Model = Model(first.value, first_bias.value, second.value, second_bias.value)
            progress("auditable_local_inference", current_step, contract.steps, evaluate(train_data, live_model))
    let model: Model = Model(first.value, first_bias.value, second.value, second_bias.value)
    let final_loss: F32 = evaluate(train_data, model)
    let test_loss: F32 = evaluate(test_data, model)
    let checkpoint_sha256: Text = save("checkpoints/equipment-health.json", model, contract, train_data, test_data, contract.steps)?
    let reloaded: Model = restore("checkpoints/equipment-health.json", contract, train_data, test_data)?
    let reloaded_loss: F32 = evaluate(test_data, reloaded)
    return Ok(TrainingReport("seloryn.auditable-training.v1", contract.model_id, contract.steps, initial_loss, final_loss, test_loss, reloaded_loss, accuracy(test_data, reloaded), checkpoint_sha256, contract.dataset_spec_hash, contract.model_spec_hash))
