{
  "name": "seloryn-language",
  "displayName": "Seloryn Language",
  "description": "Seloryn .sely tooling with syntax highlighting, real code completions, diagnostics, CPU training and hardware probes.",
  "version": "0.7.0",
  "publisher": "seloryn",
  "icon": "./assets/seloryn-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosbuilds/Seloryn.git",
    "directory": "tooling/vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": ">=1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "seloryn",
    "artificial intelligence",
    "machine learning"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:seloryn",
    "onCommand:seloryn.toggleAiGhostText",
    "onCommand:seloryn.runTraining",
    "onCommand:seloryn.inspectDevices",
    "onCommand:seloryn.runGpuProbe"
  ],
  "contributes": {
    "languages": [
      {
        "id": "seloryn",
        "aliases": [
          "Seloryn",
          "sely"
        ],
        "extensions": [
          ".sely"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "seloryn",
        "scopeName": "source.seloryn",
        "path": "./syntaxes/seloryn.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "seloryn-file-icons",
        "label": "Seloryn File Icons",
        "path": "./icons/seloryn-file-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "seloryn.toggleAiGhostText",
        "title": "Seloryn: Toggle AI Ghost Text"
      },
      {
        "command": "seloryn.runTraining",
        "title": "Seloryn: Run CPU Training in Terminal"
      },
      {
        "command": "seloryn.inspectDevices",
        "title": "Seloryn: Inspect Hardware Devices"
      },
      {
        "command": "seloryn.runGpuProbe",
        "title": "Seloryn: Run GPU Compute Probe"
      }
    ],
    "configuration": {
      "title": "Seloryn",
      "properties": {
        "seloryn.aiGhostText.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable opt-in ghost text backed by the VS Code Language Model API. The active document context may be sent to the configured provider."
        },
        "seloryn.aiGhostText.maxCharacters": {
          "type": "number",
          "default": 240,
          "minimum": 20,
          "maximum": 1000,
          "description": "Maximum number of generated ghost-text characters accepted for one suggestion."
        },
        "seloryn.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the configured Seloryn CLI on saved .sely files and publish only its structured diagnostics."
        },
        "seloryn.cliPath": {
          "type": "string",
          "default": "seloryn",
          "description": "One executable path or command name for the Seloryn CLI. Arguments are supplied separately; shell syntax is not evaluated."
        },
        "seloryn.diagnostics.timeoutMs": {
          "type": "number",
          "default": 2500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum time allowed for one saved-file check."
        },
        "seloryn.diagnostics.maxOutputBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 4096,
          "maximum": 4194304,
          "description": "Maximum combined CLI output accepted by the editor integration."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/extension.test.js && node test/package.test.js",
    "test:cli": "node test/cli.integration.test.js",
    "check": "npm test",
    "package": "npm run check && vsce package --no-dependencies && node scripts/normalize-vsix.js"
  },
  "devDependencies": {
    "@vscode/vsce": "3.7.1",
    "yauzl": "2.10.0",
    "yazl": "2.5.1"
  }
}
