{
  "name": "Seloryn",
  "scopeName": "source.seloryn",
  "fileTypes": ["sely"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.seloryn",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.seloryn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.seloryn", "match": "\\\\(?:[nrt\\\"']|u\\{[0-9A-Fa-f]+\\})" }
          ]
        },
        {
          "name": "string.quoted.single.seloryn",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.seloryn", "match": "\\\\(?:[nrt\\\"']|u\\{[0-9A-Fa-f]+\\})" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.integer.seloryn", "match": "\\b(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|[0-9](?:_?[0-9])*)\\b" },
        { "name": "constant.numeric.float.seloryn", "match": "(?<![\\w.])(?:[0-9](?:_?[0-9])*)\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?![\\w.])" }
      ]
    },
    "declarations": {
      "patterns": [
        { "match": "\\b(fn|record|enum)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)", "captures": { "1": { "name": "storage.type.declaration.seloryn" }, "2": { "name": "entity.name.function.seloryn" } } },
        { "match": "\\b(let|var|const)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)", "captures": { "1": { "name": "storage.type.binding.seloryn" }, "2": { "name": "variable.other.readwrite.seloryn" } } }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.seloryn", "match": "\\b(?:Bool|I64|F32|F64|Text|Unit|Tensor|List|Result|Option|JsonValue|JsonIoError)\\b" },
        { "match": "(:|\\[)\\s*([A-Z][\\p{L}\\p{N}_]*)", "captures": { "1": { "name": "punctuation.definition.type.seloryn" }, "2": { "name": "entity.name.type.seloryn" } } }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.seloryn", "match": "\\b(?:return|if|elif|else|for|while|loop|break|continue|match|case|require|in|is|from|import|as|pub|module)\\b" },
        { "name": "keyword.operator.logical.seloryn", "match": "\\b(?:and|or|not)\\b" },
        { "name": "storage.modifier.seloryn", "match": "\\b(?:async|await|using|defer|try|catch|finally|yield|trait|impl|class)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.builtin.seloryn", "match": "\\b(?:tensor_f32|tensor_i64|tensor_zeros_f32|tensor_zeros_i64|tensor_shape|tensor_rank|tensor_elements|tensor_dtype|tensor_to_f32|tensor_to_i64|tensor_item_f32|tensor_get_f32|tensor_get_i64|reshape|tensor_sum|tensor_mean|matmul|transpose|tensor_relu|tensor_exp|tensor_log|tensor_softmax|tensor_logsumexp|tensor_sum_to_shape|train_linear|load_checkpoint|read_stdin|read_file|parse|encode|get|as_text|as_i64|as_f32|as_f64|as_bool|ModelRequest|ModelResponse|fixture_provider|slow_fixture_provider|backward|gradcheck|print)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.call.seloryn", "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.seloryn", "match": "(?:\\|>|\\?\\?|\\?\\.|\\*\\*|//|==|!=|<=|>=|\\.\\.<|\\.\\.|->|[+*/%<>=?:.,|\\-])" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.seloryn", "match": "\\b(?:true|false|null|Ok|Err|Some|None)\\b" }
      ]
    }
  }
}
